#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Lancador do AppImage. Usa o Python da pasta env/ (ambiente conda de runtime) e o codigo em app/.
# Nao confere hash nem assinatura de nenhuma biblioteca: voce pode trocar os .so (ver LGPL-COMO-TROCAR.md).
HERE="$(dirname "$(readlink -f "$0")")"
export APPDIR="$HERE"
export PATH="$HERE/env/bin:$PATH"
# Seletor de arquivos nativo (T24): usa o portal do desktop (Favoritos, pastas de rede) quando ha barramento de
# sessao D-Bus. Sem ele (CI, terminal puro) nao muda nada e vale o seletor de reserva do Qt.
# Quem ja definiu QT_QPA_PLATFORMTHEME (ou OPENBIM_SEM_PORTAL=1) mantem a sua escolha.
if [ -z "${QT_QPA_PLATFORMTHEME:-}" ] && [ -z "${OPENBIM_SEM_PORTAL:-}" ] && [ -f "$HERE/env/lib/qt6/plugins/platformthemes/libqxdgdesktopportal.so" ]; then
  if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] || [ -S "/run/user/$(id -u)/bus" ]; then
    export QT_QPA_PLATFORMTHEME=xdgdesktopportal
  fi
fi
# Modo isolado do Python (-I = -E -s, o mesmo do atalho do Windows): ignora PYTHONPATH, PYTHONHOME e o site do usuario,
# entao uma instalacao de Python ou um PYTHONPATH do usuario nao misturam bibliotecas com as do pacote (F0-RG-13).
# freeze_support() antes do run_module: exigido pelo cartao F0-S04-T17 (pacote congelado/Windows); no Linux nao faz nada.
# A segunda janela no filho spawn e evitada pela regra do multiprocessing de nao reexecutar modulos `*.__main__` (este comando roda openbim_app.__main__).
# O Python acha o proprio ambiente pelo caminho do executavel; app/ entra no caminho aqui.
exec "$HERE/env/bin/python" -I -c 'import multiprocessing, runpy, sys; multiprocessing.freeze_support(); sys.path.insert(0, sys.argv.pop(1)); runpy.run_module("openbim_app", run_name="__main__", alter_sys=True)' "$HERE/app" "$@"
